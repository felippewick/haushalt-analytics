{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "uebrig",
  "version": "0.1.0",
  "identifier": "com.uebrig.app.local",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "uebrig",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "category": "Finance",
    "shortDescription": "Offline household expense analytics",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/models/*.gguf"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1ODdEM0MwNkIyQzJBNTkKUldSWktpeHJ3Tk9IeFRVMDhlNkVSa1JoWStuNjJTUkd2dGJCQWlMZVRWMFNrNG5JSzZta09PZnQK",
      "endpoints": [
        "https://github.com/felippewick/haushalt-analytics/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
